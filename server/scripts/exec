#!/bin/bash

source "$(dirname -- "${BASH_SOURCE[0]}")/.env"

payload=$(cat << 'EOF'
SELECT json_group_array(json_array(id, name, email))
FROM users;
EOF
)

curl -s -c "$BASE_DIR/cookies" -b "$BASE_DIR/cookies" "http://$SERVER_HOST/api/exec" \
     -H "Content-Type: application/sql" \
     -d "$payload" | jq -M

